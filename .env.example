# Copy to .env and fill in. docker compose reads .env for interpolation and for the web service.

# Required. Used by the web backend (Haiku) and by Hindsight (its own LLM calls).
ANTHROPIC_API_KEY=

# Speech to text for dictation (Groq Whisper). Optional: without it, dictation is unavailable.
GROQ_API_KEY=

# Exa web search, through its MCP server (the toolbox connects to it). Optional: without it, the exa_* tools are not offered.
EXA_API_KEY=

# Model used for chat replies.
CHAT_MODEL=claude-haiku-5-5
# Names a new conversation from its first message (prompt: services/web/prompts/conversation-title.md).
TITLE_MODEL=claude-haiku-5-5

# Accounts. Required. AUTH_SECRET signs the login tokens (changing it signs everyone out).
# ADMIN_ACCESS_KEY is typed on the /admin page to create, reset, archive and delete users.
# Generate each one with: openssl rand -base64 48
AUTH_SECRET=
ADMIN_ACCESS_KEY=

# Memory (Hindsight). Each user has their own bank, named after their username. Recall runs before every user message.
MEMORY_RECALL_BUDGET=low
MEMORY_RECALL_MAX_TOKENS=1024

# Upper bound on model steps per user message (each tool round trip is one step).
MAX_AGENT_STEPS=12
